# MP2 environment configuration
# ---------------------------------------------------------------
# Copy this file to .env and fill in your actual values

# Vocareum OpenAI Proxy (if using Vocareum)
OPENAI_API_KEY=your-vocareum-api-key-here
OPENAI_API_BASE_URL=https://openai.vocareum.com/v1

# OR use your own OpenAI API key
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_API_BASE_URL=https://api.openai.com/v1

# Qdrant Configuration
# Local Qdrant (recommended for testing):
QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY is not needed for local Qdrant

# OR Qdrant Cloud (free tier):
# QDRANT_URL=https://your-cluster-id.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-api-key
